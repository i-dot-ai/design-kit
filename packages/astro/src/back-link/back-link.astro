---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
    inverse?: boolean;
}

const { inverse = false, class: className, ...rest } = Astro.props;

const classes = [
    "govuk-back-link",
    inverse ? "govuk-back-link--inverse" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<a class={classes} {...rest}>
    <slot />
</a>
