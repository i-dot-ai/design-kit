---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    secondary?: boolean;
}

const { secondary = false, class: className, ...rest } = Astro.props;

const classes = [
    "iai-card",
    secondary ? "iai-card--secondary" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<div class={classes} {...rest}>
    <slot />
</div>
