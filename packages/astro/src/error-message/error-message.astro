---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"p"> {
    visuallyHiddenText?: string;
}

const { visuallyHiddenText = "Error", class: className, ...rest } = Astro.props;

const classes = ["govuk-error-message", className ?? ""]
    .filter(Boolean)
    .join(" ");
---

<p class={classes} {...rest}>
    {visuallyHiddenText && (
        <span class="govuk-visually-hidden">{visuallyHiddenText}:</span>
    )}
    <slot />
</p>
