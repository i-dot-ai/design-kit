---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"ul">;

const { class: className, ...rest } = Astro.props;

const classes = ["govuk-list govuk-list--spaced", className ?? ""]
    .filter(Boolean)
    .join(" ");
---

<ul class={classes} {...rest}>
    <slot />
</ul>
