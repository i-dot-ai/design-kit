---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"li"> {
    href?: string;
}

const { href, class: className, ...rest } = Astro.props;
---

<li>
    {
        href !== undefined ? (
            <a href={href} class={className} {...rest}>
                <slot />
            </a>
        ) : (
            <slot />
        )
    }
</li>
