---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"select"> {
    subtle?: boolean;
    error?: boolean;
}

const {
    subtle = false,
    error = false,
    class: className,
    ...rest
} = Astro.props;

const classes = [
    "govuk-select",
    subtle ? "govuk-select--subtle" : "",
    error ? "govuk-select--error" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<select class={classes} {...rest}>
    <slot />
</select>
