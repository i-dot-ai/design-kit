---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"textarea"> {
    error?: boolean;
    subtle?: boolean;
    value?: string;
}

const {
    error = false,
    subtle = false,
    value = "",
    class: className,
    ...rest
} = Astro.props;

const classes = [
    "govuk-textarea",
    error ? "govuk-textarea--error" : "",
    subtle ? "govuk-textarea--subtle" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<textarea class={classes} {...rest}>{value}</textarea>
