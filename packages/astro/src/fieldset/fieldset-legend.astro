---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"legend"> {
    size?: string;
    isPageHeading?: boolean;
}

const { size, isPageHeading, class: className, ...rest } = Astro.props;

const classes = [
    "govuk-fieldset__legend",
    {
        small: "govuk-fieldset__legend--s",
        medium: "govuk-fieldset__legend--m",
        large: "govuk-fieldset__legend--l",
        xl: "govuk-fieldset__legend--xl",
    }[size] ?? "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<legend class={classes} {...rest}>
    {
        isPageHeading ? (
            <h1 class="govuk-fieldset__heading">
                <slot />
            </h1>
        ) : (
            <slot />
        )
    }
</legend>
