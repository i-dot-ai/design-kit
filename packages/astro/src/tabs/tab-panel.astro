---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    hidden?: boolean;
}

const { hidden = false, class: className, ...rest } = Astro.props;

const classes = [
    "govuk-tabs__panel",
    hidden ? "govuk-tabs__panel--hidden" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<div class={classes} {...rest}>
    <slot />
</div>
