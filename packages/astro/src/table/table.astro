---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"table"> {
    smallTextUntilTablet?: boolean;
    subtle?: boolean;
    summary?: boolean;
}

const {
    smallTextUntilTablet = false,
    subtle = false,
    summary = false,
    class: className,
    ...rest
} = Astro.props;

const classes = [
    "govuk-table",
    smallTextUntilTablet ? "govuk-table--small-text-until-tablet" : "",
    subtle ? "govuk-table--subtle" : "",
    summary ? "govuk-table--summary" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<table class={classes} {...rest}>
    <slot />
</table>
