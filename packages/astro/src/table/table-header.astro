---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"th"> {
    numeric?: boolean;
    scope?: string;
}

const { numeric = false, scope = "col", class: className, ...rest } = Astro.props;

const classes = [
    "govuk-table__header",
    numeric ? "govuk-table__header--numeric" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<th class={classes} scope={scope} {...rest}>
    <slot />
</th>
