---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    single?: boolean;
}

const { single, class: className, ...rest } = Astro.props;

const classes = ["govuk-summary-card__actions", className ?? ""]
    .filter(Boolean)
    .join(" ");
---

{
    single ? (
        <div class={classes} {...rest}>
            <slot />
        </div>
    ) : (
        <ul class={classes} {...rest}>
            <slot />
        </ul>
    )
}
