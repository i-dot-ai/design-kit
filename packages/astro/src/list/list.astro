---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"ol"> {
    spaced?: boolean;
    numbered?: boolean;
}

const { spaced = false, numbered, class: className, ...rest } = Astro.props;
---

{
    numbered ? (
        <ol
            class={[
                "govuk-list govuk-list--number",
                spaced ? "govuk-list--spaced" : "",
                className ?? "",
            ]
                .filter(Boolean)
                .join(" ")}
            {...rest}
        >
            <slot />
        </ol>
    ) : (
        <ul
            class={[
                "govuk-list",
                spaced ? "govuk-list--spaced" : "",
                className ?? "",
            ]
                .filter(Boolean)
                .join(" ")}
            {...rest}
        >
            <slot />
        </ul>
    )
}
