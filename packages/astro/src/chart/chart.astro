---
// Server-rendered like the plain HTML version; the central behaviour layer
// (initAllIAIDesignSystem) draws the chart from the table on the page.
import type { HTMLAttributes } from "astro/types";
import { formatChartValue } from "@i-dot-ai-npm/component-library-frontend";
import type { ChartData, ChartHeadingLevel, ChartVariant } from "@i-dot-ai-npm/component-library-frontend";
import Details from "../details/details.astro";
import DetailsSummary from "../details/details-summary.astro";
import DetailsText from "../details/details-text.astro";
import Table from "../table/table.astro";
import TableCaption from "../table/table-caption.astro";
import TableHead from "../table/table-head.astro";
import TableBody from "../table/table-body.astro";
import TableRow from "../table/table-row.astro";
import TableHeader from "../table/table-header.astro";
import TableCell from "../table/table-cell.astro";

interface Props extends Omit<HTMLAttributes<"div">, "title"> {
    variant: ChartVariant;
    /** Shown as the heading and the table caption, and used as the chart's accessible name. */
    title: string;
    /** A short summary of what the chart shows. Shown under the title and read out with the chart. */
    description?: string;
    /** The title's heading level. Defaults to 3. */
    headingLevel?: ChartHeadingLevel;
    data: ChartData;
    /**
     * Intl.NumberFormat options for the values in the table, on the axes, in
     * tooltips and in value labels. For example `{ style: "unit", unit: "minute" }`.
     */
    format?: Intl.NumberFormatOptions;
}

const { variant, title, description, headingLevel = 3, data, format, class: className, ...rest } = Astro.props;
const Heading = `h${headingLevel}`;

const classes = ["iai-chart", `iai-chart--${variant}`, className ?? ""].filter(Boolean).join(" ");
// Pie and doughnut colour each label from the first dataset's colour list.
const firstColour = data.datasets[0]?.colour;
const sliceColours = Array.isArray(firstColour) ? firstColour : [];
---

<div class={classes} data-module="iai-chart" data-iai-chart-format={format ? JSON.stringify(format) : undefined} {...rest}>
    <Heading class="govuk-heading-m">{title}</Heading>
    {description && <p class="govuk-body iai-chart__description">{description}</p>}
    <Details>
        <DetailsSummary>Show data<span class="govuk-visually-hidden"> for {title}</span></DetailsSummary>
        <DetailsText>
            <Table>
                <TableCaption size="small">{title}</TableCaption>
                <TableHead>
                    <TableRow>
                        <TableHeader>{data.heading}</TableHeader>
                        {data.datasets.map((dataset) => (
                            <TableHeader
                                numeric
                                data-iai-chart-colour={Array.isArray(dataset.colour) ? undefined : dataset.colour}
                                data-iai-chart-line={dataset.line}
                            >
                                {dataset.label}
                            </TableHeader>
                        ))}
                    </TableRow>
                </TableHead>
                <TableBody>
                    {data.labels.map((label, row) => (
                        <TableRow>
                            <TableHeader scope="row" data-iai-chart-colour={sliceColours[row]}>{label}</TableHeader>
                            {data.datasets.map((dataset) => {
                                const value = dataset.data[row];
                                return (
                                    <TableCell numeric data-value={format && value != null ? value : undefined}>
                                        {formatChartValue(value ?? null, format)}
                                    </TableCell>
                                );
                            })}
                        </TableRow>
                    ))}
                </TableBody>
            </Table>
        </DetailsText>
    </Details>
</div>
