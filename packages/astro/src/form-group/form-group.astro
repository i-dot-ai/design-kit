---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
    inline?: boolean;
}

const { inline = false, class: className, ...rest } = Astro.props;

const classes = [
    "govuk-form-group",
    inline ? "govuk-form-group--inline" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<div class={classes} {...rest}>
    <slot />
</div>
