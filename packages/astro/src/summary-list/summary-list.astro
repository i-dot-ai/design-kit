---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"dl"> {
    noBorder?: boolean;
}

const { noBorder = false, class: className, ...rest } = Astro.props;

const classes = [
    "govuk-summary-list",
    noBorder ? "govuk-summary-list--no-border" : "",
    className ?? "",
]
    .filter(Boolean)
    .join(" ");
---

<dl class={classes} {...rest}>
    <slot />
</dl>
