{
    "compilerOptions": {
        "strict": true,
        "moduleResolution": "bundler",
        "module": "esnext",
        "target": "esnext",
        "lib": ["esnext", "dom", "dom.iterable"],
        "skipLibCheck": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "types": []
    },
    "include": ["src/**/*.ts"]
}
