{
    "compilerOptions": {
        "strict": true,
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "module": "esnext",
        "target": "esnext",
        "lib": ["esnext", "dom", "dom.iterable"],
        "skipLibCheck": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "types": ["react"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"]
}
