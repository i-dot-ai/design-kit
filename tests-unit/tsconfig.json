{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "jsx": "preserve",
    "noEmit": true,
    "verbatimModuleSyntax": false
  },
  "include": ["src", "vitest.config.ts"]
}
