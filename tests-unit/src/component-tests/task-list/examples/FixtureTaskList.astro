---
import {
    TaskList,
    TaskListItem,
    TaskListNameAndHint,
    TaskListLink,
    TaskListHint,
    TaskListStatus,
    Tag,
} from "@i-dot-ai-npm/component-library-astro";

const { idPrefix, items } = Astro.props;

type Item = {
    index: number;
    title: string;
    href?: string;
    itemClasses?: string;
    hint?: string;
    statusText?: string;
    statusClasses?: string;
    statusTagText?: string;
    statusTagClasses?: string;
};
---

<TaskList>
    {
        (items as Item[]).map((item) => {
            const hintId = `${idPrefix}-${item.index}-hint`;
            const statusId = `${idPrefix}-${item.index}-status`;
            const describedBy = item.hint ? `${hintId} ${statusId}` : statusId;
            return (
                <TaskListItem withLink={item.href !== undefined} class={item.itemClasses}>
                    <TaskListNameAndHint>
                        {item.href !== undefined ? (
                            <TaskListLink href={item.href} aria-describedby={describedBy}>
                                {item.title}
                            </TaskListLink>
                        ) : (
                            <div>{item.title}</div>
                        )}
                        {item.hint && <TaskListHint id={hintId}>{item.hint}</TaskListHint>}
                    </TaskListNameAndHint>
                    <TaskListStatus id={statusId} class={item.statusClasses}>
                        {item.statusTagText !== undefined ? (
                            <Tag class={item.statusTagClasses}>{item.statusTagText}</Tag>
                        ) : (
                            item.statusText
                        )}
                    </TaskListStatus>
                </TaskListItem>
            );
        })
    }
</TaskList>
