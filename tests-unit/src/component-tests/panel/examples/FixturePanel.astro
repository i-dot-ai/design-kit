---
import { Panel, PanelTitle, PanelBody, PanelActions } from "@i-dot-ai-npm/component-library-astro";

const { classes, titleText, titleHtml, text, html, hasActions, actions } = Astro.props;
---

<Panel class={classes}>
    <PanelTitle>
        {titleHtml ? <Fragment set:html={titleHtml} /> : titleText}
    </PanelTitle>
    {(html || text) && (
        <PanelBody>
            {html ? <Fragment set:html={html} /> : text}
        </PanelBody>
    )}
    {hasActions && (
        <PanelActions>
            {actions.length > 0 && (
                <div class="govuk-button-group">
                    {actions.map((action: any) =>
                        action.href && action.type !== "button" ? (
                            <a class="govuk-link govuk-link--inverse" href={action.href}>{action.text}</a>
                        ) : (
                            <button type={action.type ?? "button"} class="govuk-button govuk-button--inverse" data-module="govuk-button" {...(action.attributes ?? {})}>{action.text}</button>
                        )
                    )}
                </div>
            )}
        </PanelActions>
    )}
</Panel>
