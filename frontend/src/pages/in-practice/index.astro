---
import Layout from "@layouts/InPracticeLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import {
    CardGroup,
    Card,
    CardHeading,
    CardLink,
    CardContent,
} from "@i-dot-ai-npm/component-library-astro";

const entry = await getEntry("in-practice", "index");
if (!entry) throw new Error("Missing in-practice/index.mdx");
const { Content } = await render(entry);

const stories = (await getCollection("in-practice", ({ id }) => id !== "index")).sort(
    (a, b) =>
        (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
        a.data.title.localeCompare(b.data.title),
);
---

<Layout>
    <h1 class="govuk-heading-xl">{entry.data.title}</h1>
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <Content />
        </div>
    </div>
    <h2 class="govuk-heading-l">Examples</h2>
    <CardGroup>
        {
            stories.map((story) => (
                <Card>
                    <CardHeading>
                        <h3 class="govuk-heading-m">
                            <span class="govuk-caption-m">{story.data.product}</span>
                            <CardLink href={`/in-practice/${story.id}`}>
                                {story.data.title}
                            </CardLink>
                        </h3>
                    </CardHeading>
                    <CardContent>
                        <p class="govuk-body-s">{story.data.description}</p>
                    </CardContent>
                </Card>
            ))
        }
    </CardGroup>
</Layout>
