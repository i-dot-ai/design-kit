---
import Layout from "@layouts/InPracticeLayout.astro";
import StoryTimeline from "@components/in-practice/story-timeline.astro";
import StoryStep from "@components/in-practice/story-step.astro";
import BeforeAfter from "@components/in-practice/before-after.astro";
import LivePrototype from "@components/in-practice/live-prototype.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    // The in-folder landing page (in-practice/index.mdx) is rendered by
    // in-practice/index.astro, not as a story slug.
    const entries = await getCollection("in-practice", ({ id }) => id !== "index");
    return entries.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, product, team, when, kitUsed, fullStory } = entry.data;

// Every story opens with the same summary, built from its frontmatter.
const glance = [
    { key: "Product", value: product },
    { key: "Team", value: team },
    { key: "When", value: when },
].filter((row) => row.value);
---

<Layout>
    {product && <span class="govuk-caption-xl">{product}</span>}
    <h1 class="govuk-heading-xl">{title}</h1>
    {description && <p class="govuk-body-l app-in-practice-glance">{description}</p>}

    <h2 class="govuk-heading-m">At a glance</h2>
    <dl class="govuk-summary-list app-in-practice-glance">
        {
            glance.map((row) => (
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">{row.key}</dt>
                    <dd class="govuk-summary-list__value">{row.value}</dd>
                </div>
            ))
        }
        {
            kitUsed.length > 0 && (
                <div class="govuk-summary-list__row">
                    <dt class="govuk-summary-list__key">Kit used</dt>
                    <dd class="govuk-summary-list__value">
                        <ul class="govuk-list govuk-!-margin-bottom-0">
                            {kitUsed.map((item) => (
                                <li>
                                    <a class="govuk-link" href={item.href}>
                                        {item.text}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </dd>
                </div>
            )
        }
    </dl>

    <div class="app-in-practice-body">
        <Content components={{ StoryTimeline, StoryStep, BeforeAfter, LivePrototype }} />
    </div>

    {
        fullStory && (
            <aside class="app-in-practice-full-story" aria-labelledby="full-story-heading">
                <h2 class="govuk-heading-m" id="full-story-heading">
                    Read the full story
                </h2>
                <p class="govuk-body">{fullStory.description}</p>
                <a class="govuk-button govuk-!-margin-bottom-2" href={fullStory.href}>
                    {fullStory.title}
                </a>
                {fullStory.access && (
                    <p class="govuk-body-s govuk-!-margin-bottom-0">{fullStory.access}</p>
                )}
            </aside>
        )
    }
</Layout>
