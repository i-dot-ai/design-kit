---
// test/chart/[variant]/svelte.astro
import Layout from "@layouts/TestLayout.astro";
import Line from "../../../../content/components/chart/examples/line.svelte";
import LineGrid from "../../../../content/components/chart/examples/line-grid.svelte";
import LineFormat from "../../../../content/components/chart/examples/line-format-function.svelte";
import Area from "../../../../content/components/chart/examples/area.svelte";
import Bar from "../../../../content/components/chart/examples/bar.svelte";
import HorizontalBar from "../../../../content/components/chart/examples/horizontal-bar.svelte";
import Pie from "../../../../content/components/chart/examples/pie.svelte";
import Doughnut from "../../../../content/components/chart/examples/doughnut.svelte";

export function getStaticPaths() {
    return ["line", "line-grid", "line-format-function", "area", "bar", "horizontal-bar", "pie", "doughnut"].map((variant) => ({
        params: { variant },
    }));
}

const { variant } = Astro.params;
---

<Layout>
    {variant === "line" && <Line client:load />}
    {variant === "line-grid" && <LineGrid client:load />}
    {variant === "line-format-function" && <LineFormat client:load />}
    {variant === "area" && <Area client:load />}
    {variant === "bar" && <Bar client:load />}
    {variant === "horizontal-bar" && <HorizontalBar client:load />}
    {variant === "pie" && <Pie client:load />}
    {variant === "doughnut" && <Doughnut client:load />}
</Layout>
