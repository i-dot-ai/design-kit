---
import Layout from "@layouts/TestLayout.astro";

export function getStaticPaths() {
    const files = import.meta.glob(
        "/src/content/{components,patterns}/*/examples/*.html",
        { query: "?raw", import: "default", eager: true },
    ) as Record<string, string>;

    return Object.entries(files).map(([path, html]) => {
        // ".../content/{components,patterns}/<component>/examples/<variant>.html"
        const [, rest] = path.split("/content/");
        const [, component, , file] = rest.split("/");
        const variantName = file.replace(/\.html$/, "");
        return { params: { component, variant: variantName }, props: { html } };
    }).filter((p) => !p.params.variant.endsWith(".web-components"));
}

const { html } = Astro.props;
---

<Layout>
    <div set:html={html} />
</Layout>
