---
import Layout from "@layouts/TestLayout.astro";

export function getStaticPaths() {
    const files = import.meta.glob(
        "/src/content/components/*/examples/*.html",
        { query: "?raw", import: "default", eager: true },
    ) as Record<string, string>;

    return Object.entries(files).map(([path, html]) => {
        // ".../content/components/<component>/examples/<variant>.html"
        const [, rest] = path.split("/content/components/");
        const component = rest.split("/")[0];
        const file = rest.split("/").pop()!; // "<variant>.html"
        const variantName = file.replace(/\.html$/, ""); // "<variant>"
        return { params: { component, variant: variantName }, props: { html } };
    });
}

const { html } = Astro.props;
---

<Layout>
    <div set:html={html} />
</Layout>
