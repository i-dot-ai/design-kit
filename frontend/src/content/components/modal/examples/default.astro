---
import {
    Button,
    Modal,
    ModalTitle,
    ModalBody,
    ModalFooter,
} from "@i-dot-ai-npm/component-library-astro";
---

<Button type="button" data-iai-modal-open="astro-modal" data-testid="open">
    Open modal
</Button>

<Modal id="astro-modal" aria-labelledby="astro-modal-title" data-testid="modal">
    <ModalTitle id="astro-modal-title">Delete item</ModalTitle>
    <ModalBody>
        <p class="govuk-body">Are you sure you want to delete this item?</p>
    </ModalBody>
    <ModalFooter>
        <Button
            type="button"
            warning
            data-iai-modal-close
            data-testid="confirm"
        >
            Delete
        </Button>
        <Button
            type="button"
            secondary
            data-iai-modal-close
            data-testid="cancel"
        >
            Cancel
        </Button>
    </ModalFooter>
</Modal>
