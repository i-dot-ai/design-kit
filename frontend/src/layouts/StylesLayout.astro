---
import Layout from "@layouts/Layout.astro";
import {
    Breadcrumbs,
    BreadcrumbItem,
    ContentsPanel,
    ContentsPanelList,
    ContentsPanelItem,
    ContentsPanelListHeading,
} from "@i-dot-ai-npm/component-library-astro";

const currentPath = Astro.url.pathname;

const pages = [
    {
        text: "Branding",
        href: "/styles/branding",
    },
    {
        text: "typography",
        href: "/styles/typography",
    },
    {
        text: "Colour palette",
        href: "/styles/colour-palette",
    },
    {
        text: "Chart colours",
        href: "/styles/chart-colours",
    },
    {
        text: "Public facing landing page",
        href: "/styles/public-facing-landing-page",
    },
    {
        text: "Main application structure",
        href: "/styles/main-application-structure",
    },
];
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-quarter">
                <ContentsPanel>
                    <ContentsPanelList>
                        {
                            pages.map((page) => (
                                <ContentsPanelItem
                                    href={page.href}
                                    current={currentPath.includes(page.href)}
                                >
                                    {page.text}
                                </ContentsPanelItem>
                            ))
                        }
                    </ContentsPanelList>
                </ContentsPanel>
            </div>
            <div class="govuk-grid-column-three-quarters">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/styles" && (
                            <BreadcrumbItem href="/styles">
                                Styles
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
