---
import "../styles/govuk.scss";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>i.AI Design System</title>
	</head>
	<body class="govuk-template__body govuk-template__body--iai-theme">
		<script is:inline>
			document.body.className +=
				" js-enabled" +
				("noModule" in HTMLScriptElement.prototype
					? " govuk-frontend-supported"
					: "");
		</script>
		<slot />
		<script>
			import { initAll } from "govuk-frontend";
			import { initAllIAIDesignSystem } from "@i-dot-ai-npm/component-library-frontend";
			initAll();
			initAllIAIDesignSystem();
		</script>
	</body>
</html>
