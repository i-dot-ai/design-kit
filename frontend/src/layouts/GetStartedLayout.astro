---
import Layout from "@layouts/Layout.astro";
import {
    Breadcrumbs,
    BreadcrumbItem,
    ContentsPanel,
    ContentsPanelList,
    ContentsPanelItem,
    ContentsPanelListHeading,
} from "@i-dot-ai-npm/component-library-astro";

const currentPath = Astro.url.pathname;

const guides = [
    {
        text: "Design a prototype",
        href: "/get-started/design-a-prototype",
    },
    {
        text: "Build a product interface",
        href: "/get-started/build-a-product-interface",
    },
    {
        text: "Update a product interface",
        href: "/get-started/update-a-product-interface",
    },
    {
        text: "Contribute to the Design Kit",
        href: "/get-started/contribute-to-the-design-kit",
    },
];
const maintainersGuides = [
    {
        text: "Maintain the Design Kit",
        href: "/get-started/maintain-the-design-kit",
    },
];
---

<Layout>
    <div class="govuk-main-wrapper govuk-width-container">
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-quarter">
                <ContentsPanel>
                    <ContentsPanelListHeading>Guides</ContentsPanelListHeading>
                    <ContentsPanelList>
                        {
                            guides.map((category) => (
                                <ContentsPanelItem
                                    href={category.href}
                                    current={currentPath.includes(
                                        category.href,
                                    )}
                                >
                                    {category.text}
                                </ContentsPanelItem>
                            ))
                        }
                    </ContentsPanelList>
                    <ContentsPanelListHeading
                        >For maintainers</ContentsPanelListHeading
                    >
                    <ContentsPanelList>
                        {
                            maintainersGuides.map((category) => (
                                <ContentsPanelItem
                                    href={category.href}
                                    current={currentPath.includes(
                                        category.href,
                                    )}
                                >
                                    {category.text}
                                </ContentsPanelItem>
                            ))
                        }
                    </ContentsPanelList>
                </ContentsPanel>
            </div>
            <div class="govuk-grid-column-three-quarters">
                <Breadcrumbs>
                    <BreadcrumbItem href="/">Home</BreadcrumbItem>
                    {
                        currentPath !== "/get-started" && (
                            <BreadcrumbItem href="/get-started">
                                Get started
                            </BreadcrumbItem>
                        )
                    }
                </Breadcrumbs>
                <slot />
            </div>
        </div>
    </div>
</Layout>
