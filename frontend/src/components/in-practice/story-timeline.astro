---
import { PaginationNext } from "@i-dot-ai-npm/component-library-astro";

const id = `story-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="app-story govuk-!-margin-bottom-7" id={id} data-app-story>
    <p class="govuk-body app-story__skip">
        <a class="govuk-link" href={`#${id}-end`}>Skip to the end of the timeline</a>
    </p>
    <div class="app-story__stage">
        <div class="app-story__frame" aria-hidden="true"></div>
        <nav class="app-story__nav" aria-label="Timeline">
            <ol class="app-story__progress"></ol>
            {/* Not <Pagination>: it would add a second nav landmark. */}
            <div class="govuk-pagination govuk-pagination--block govuk-!-margin-top-3 govuk-!-margin-bottom-0 app-story__next" hidden>
                <PaginationNext block href="#" labelText=" ">
                    Next<span class="govuk-visually-hidden"> step</span>
                </PaginationNext>
            </div>
        </nav>
    </div>
    <ol class="app-story__steps">
        <slot />
    </ol>
</div>
<div class="app-story__end" id={`${id}-end`} tabindex="-1"></div>

<script>
    for (const story of document.querySelectorAll<HTMLElement>("[data-app-story]")) {
        const steps = [...story.querySelectorAll<HTMLElement>(".app-story__step")];
        const frame = story.querySelector(".app-story__frame");
        const progress = story.querySelector(".app-story__progress");
        if (!frame || !progress || !steps.length) continue;

        const shots = steps.map((step) => {
            const img = step.querySelector("img");
            const shot = img ? (img.cloneNode() as HTMLImageElement) : document.createElement("img");
            shot.removeAttribute("loading");
            shot.alt = "";
            shot.className = "app-story__shot";
            frame.append(shot);
            return shot;
        });

        const links = steps.map((step, i) => {
            step.id = `${story.id}-step-${i}`;
            step.tabIndex = -1;
            const item = document.createElement("li");
            item.className = "app-story__dot govuk-!-padding-top-2";
            const link = document.createElement("a");
            link.className = "govuk-link app-story__dot-link";
            link.href = `#${step.id}`;
            link.textContent = step.dataset.short ?? "";
            link.setAttribute("aria-label", `${link.textContent}: ${step.dataset.title ?? ""}`);
            item.append(link);
            progress.append(item);
            return { item, link };
        });

        const next = story.querySelector<HTMLElement>(".app-story__next");
        const nextLink = next?.querySelector("a");
        const nextLabel = next?.querySelector(".govuk-pagination__link-label");
        const pointNext = (index: number) => {
            if (!next || !nextLink || !nextLabel) return;
            const target = steps[index + 1];
            next.hidden = !target;
            if (!target) return;
            nextLink.href = `#${target.id}`;
            nextLabel.textContent = links[index + 1].link.getAttribute("aria-label");
        };

        const show = (index: number) => {
            pointNext(index);
            steps.forEach((step, i) => step.classList.toggle("app-story__step--active", i === index));
            shots.forEach((shot, i) => shot.classList.toggle("app-story__shot--active", i === index));
            links.forEach(({ item, link }, i) => {
                item.classList.toggle("app-story__dot--active", i <= index);
                if (i === index) link.setAttribute("aria-current", "step");
                else link.removeAttribute("aria-current");
            });
        };
        show(0);

        // The active step is the one crossing the middle of the viewport.
        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (entry.isIntersecting) show(steps.indexOf(entry.target as HTMLElement));
                }
            },
            { rootMargin: "-50% 0px -50% 0px" },
        );
        steps.forEach((step) => observer.observe(step));
        story.classList.add("app-story--enhanced");
    }
</script>
