---
// short: optional shorter name for the timeline, if label is too long.
interface Props {
    label: string;
    short?: string;
    title: string;
    image: string;
    alt: string;
    href?: string;
    linkText?: string;
}

const { label, short, title, image, alt, href, linkText = "Read the full decision" } = Astro.props;
---

<li class="app-story__step govuk-!-padding-left-4" data-short={short ?? label} data-title={title}>
    <h3 class="govuk-heading-m">
        <span class="govuk-caption-m">{label}</span>
        {title}
    </h3>
    <slot />
    {
        href && (
            <p class="govuk-body">
                <a class="govuk-link" href={href}>
                    {linkText}
                    <span class="govuk-visually-hidden">: {title}</span>
                </a>
            </p>
        )
    }
    <figure class="app-story__figure">
        <img src={image} alt={alt} loading="lazy" />
    </figure>
</li>
