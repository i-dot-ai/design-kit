---
/*
 * One step in a <StoryTimeline>. The body is Markdown.
 *
 * label:  shown above the title, for example "Prototype 1.2"
 * short:  shown in the timeline's progress bar, for example "1.2"
 * image:  a screenshot of this step, from /public
 * alt:    describes what the screenshot shows
 * href:   optional link to the full decision for this step
 */
interface Props {
    label: string;
    short?: string;
    title: string;
    image: string;
    alt: string;
    href?: string;
    linkText?: string;
}

const { label, short, title, image, alt, href, linkText = "Read the full decision" } = Astro.props;
---

<li class="app-story__step" data-short={short ?? label}>
    <span class="govuk-caption-m">{label}</span>
    <h3 class="govuk-heading-m">{title}</h3>
    <slot />
    {
        href && (
            <p class="govuk-body">
                <a class="govuk-link" href={href}>
                    {linkText}
                    <span class="govuk-visually-hidden">: {title}</span>
                </a>
            </p>
        )
    }
    <figure class="app-story__figure">
        <img src={image} alt={alt} loading="lazy" />
    </figure>
</li>
